<UserControl x:Class="GTS.Billing.Presentation.Wpf.CompanyPresentationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,12,7"/></Style>
  <DataTemplate DataType="{x:Type local:CompanyField}">
   <StackPanel Margin="0,4">
    <TextBlock Text="{Binding Label}"/>
    <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Padding="4"
      AutomationProperties.Name="{Binding Label}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="EditorActions">
   <WrapPanel Margin="0,8">
    <Button Content="{DynamicResource Display.Common.Edit}" Command="{Binding EditRecordCommand}" Visibility="{Binding Viewing,Converter={StaticResource Visible}}" IsEnabled="{Binding CanEditViewed}"/>
    <Button Content="{DynamicResource Display.Common.Save}" Command="{Binding SaveRecordCommand}" Visibility="{Binding Editing,Converter={StaticResource Visible}}" IsEnabled="{Binding CanWriteRecord}"/>
    <Button Content="{DynamicResource Display.CompanyPresentation.Content.CloseDetails}" Command="{Binding CloseRecordCommand}" Visibility="{Binding Viewing,Converter={StaticResource Visible}}"/>
    <Button Content="{DynamicResource Display.Common.Cancel}" Command="{Binding CloseRecordCommand}" Visibility="{Binding Editing,Converter={StaticResource Visible}}"/>
   </WrapPanel>
  </DataTemplate>

  <DataTemplate x:Key="Section1">
<Grid Margin="10">
     <DockPanel>
      <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding LogoOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></DockPanel.Style>
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <TextBox Width="230" Margin="0,0,8,4" MaxLength="100" Padding="5"
         Text="{Binding LogoSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search company logos by name or usage"
         ToolTip="Search starts at three characters"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.AddLogo}" Command="{Binding AddLogoCommand}" IsEnabled="{Binding CanManageLogos}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.ViewLogo}" Command="{Binding OpenLogoCommand}"/>
      </WrapPanel>
      <DataGrid ItemsSource="{Binding Logos}" SelectedItem="{Binding SelectedLogo}" IsReadOnly="True" AutoGenerateColumns="False"
        SelectionMode="Single" CanUserAddRows="False" local:MasterGridInteraction.ViewRowCommand="{Binding OpenLogoCommand}"
        AutomationProperties.Name="Company logos" local:SettingsDisplay.GridId="Logos">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Preview" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Preview" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Image Source="{Binding Preview}" Width="76" Height="48" Stretch="Uniform"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Name" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Name" Binding="{Binding Row.Name}" Width="*"/>
        <DataGridTextColumn Header="Usage" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Usage" Binding="{Binding Row.Usage}"/>
        <DataGridTextColumn Header="Order" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Order" Binding="{Binding Row.Order}"/>
        <DataGridTextColumn Header="Status" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Status" Binding="{Binding Row.Status}"/>
        <DataGridTextColumn Header="Invoice slot" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.InvoiceSlot" Binding="{Binding Row.InvoiceSlot}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
     <Border Background="{DynamicResource Palette.Canvas}" Padding="12" Visibility="{Binding LogoOpen,Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="{DynamicResource Display.CompanyPresentation.Text.LogoDetails}" FontSize="20" FontWeight="SemiBold"/>
        <Image Source="{Binding LogoPreview}" Height="110" MaxWidth="320" HorizontalAlignment="Left"/>
        <StackPanel IsEnabled="{Binding CanWriteRecord}">
         <ItemsControl ItemsSource="{Binding Fields}"/>
         <Label Content="{DynamicResource Display.CompanyPresentation.Content.Usage}" Target="{Binding ElementName=LogoUsage}"/>
         <ComboBox x:Name="LogoUsage" ItemsSource="{Binding LogoUsages}" SelectedItem="{Binding Usage}" AutomationProperties.Name="Logo usage"/>
         <CheckBox Content="{DynamicResource Display.Common.Active}" IsChecked="{Binding Active}"/>
        </StackPanel>
        <WrapPanel Visibility="{Binding Editing,Converter={StaticResource Visible}}">
         <Button Content="{DynamicResource Display.CompanyPresentation.Content.ChooseOrReplaceImage}" Click="ChooseImage" IsEnabled="{Binding CanWriteRecord}"/>
         <Button Content="{DynamicResource Display.CompanyPresentation.Content.RemoveUnusedLogo}" Command="{Binding RemoveLogoCommand}" IsEnabled="{Binding CanWriteRecord}"/>
        </WrapPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditorActions}"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Section2">
<Grid Margin="10">
     <DockPanel>
      <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding BankOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></DockPanel.Style>
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <TextBox Width="230" Margin="0,0,8,4" MaxLength="100" Padding="5"
         Text="{Binding BankSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search banks, account holders, IFSC or branch"
         ToolTip="Search starts at three characters"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.AddBankAccount}" Command="{Binding AddBankCommand}" IsEnabled="{Binding CanManageBanks}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.ViewBankAccount}" Command="{Binding OpenBankCommand}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.SetInvoiceDefault}" Command="{Binding SetInvoiceBankCommand}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.ClearInvoiceDefault}" Command="{Binding ClearInvoiceBankCommand}"/>
      </WrapPanel>
      <DataGrid ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}" IsReadOnly="True" AutoGenerateColumns="False"
        SelectionMode="Single" CanUserAddRows="False" local:MasterGridInteraction.ViewRowCommand="{Binding OpenBankCommand}"
        AutomationProperties.Name="Company bank accounts" local:SettingsDisplay.GridId="Banks">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Bank" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Bank" Binding="{Binding BankName}" Width="*"/>
        <DataGridTextColumn Header="Account holder" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.AccountHolder" Binding="{Binding AccountHolder}"/>
        <DataGridTextColumn Header="Account number" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.AccountNumber" Binding="{Binding MaskedNumber}"/>
        <DataGridTextColumn Header="IFSC" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.IFSC" Binding="{Binding Ifsc}"/>
        <DataGridTextColumn Header="Branch" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Branch" Binding="{Binding Branch}"/>
        <DataGridTextColumn Header="Type" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Type" Binding="{Binding AccountType}"/>
        <DataGridCheckBoxColumn Header="Active" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Active" Binding="{Binding Active}"/>
        <DataGridCheckBoxColumn Header="Invoice default" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.InvoiceDefault" Binding="{Binding Default}"/>
        <DataGridTextColumn Header="Order" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Order" Binding="{Binding Order}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
     <Border Background="{DynamicResource Palette.Canvas}" Padding="12" Visibility="{Binding BankOpen,Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="{DynamicResource Display.CompanyPresentation.Text.BankAccountDetails}" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel IsEnabled="{Binding CanWriteRecord}">
         <ItemsControl ItemsSource="{Binding Fields}"/>
         <CheckBox Content="{DynamicResource Display.Common.Active}" IsChecked="{Binding Active}"/>
        </StackPanel>
        <TextBlock Text="Deactivating the default leaves invoices without a bank selection. Choose another in Invoice Defaults." TextWrapping="Wrap"/>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditorActions}"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Section3">
<ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <StackPanel IsEnabled="{Binding CanWriteDefaults}">
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.PrimaryLogo}" Target="{Binding ElementName=PrimaryLogo}"/>
      <local:SearchableComboBox x:Name="PrimaryLogo" SearchItemsSource="{Binding LogoChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
        SelectedValue="{Binding Defaults.Primary,Mode=TwoWay}" AutomationProperties.Name="Primary invoice logo"/>
      <CheckBox Content="{DynamicResource Display.CompanyPresentation.Content.ShowPrimaryLogoOnInvoices}" IsChecked="{Binding Defaults.ShowPrimary}"/>
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.SecondaryLogo}" Target="{Binding ElementName=SecondaryLogo}"/>
      <local:SearchableComboBox x:Name="SecondaryLogo" SearchItemsSource="{Binding LogoChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
        SelectedValue="{Binding Defaults.Secondary,Mode=TwoWay}" AutomationProperties.Name="Secondary invoice logo"/>
      <CheckBox Content="{DynamicResource Display.CompanyPresentation.Content.ShowSecondaryLogoOnInvoices}" IsChecked="{Binding Defaults.ShowSecondary}"/>
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.DefaultBankAccount}" Target="{Binding ElementName=DefaultBank}"/>
      <local:SearchableComboBox x:Name="DefaultBank" SearchItemsSource="{Binding BankChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" IsEnabled="{Binding CanEditDefaultBank}"
        SelectedValue="{Binding Defaults.Bank,Mode=TwoWay}" AutomationProperties.Name="Invoice default bank account"/>
      <TextBlock Text="{DynamicResource Display.CompanyPresentation.Text.TheSelectedDefaultBankAccountIsIncludedOnInvoices}" TextWrapping="Wrap" Margin="0,5"/>
      <CheckBox Content="{DynamicResource Display.CompanyPresentation.Content.ShowUPIFromTheDefaultAccount}" IsChecked="{Binding Defaults.ShowUpi}"/>
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.HeaderText}" Target="{Binding ElementName=HeaderText}"/>
      <TextBox x:Name="HeaderText" Text="{Binding Defaults.Header,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"
        TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38"/>
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.FooterText}" Target="{Binding ElementName=FooterText}"/>
      <TextBox x:Name="FooterText" Text="{Binding Defaults.Footer,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"
        TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38"/>
      <Label Content="_Authorized signatory name" Target="{Binding ElementName=Signatory}"/>
      <TextBox x:Name="Signatory" Text="{Binding Defaults.Signatory,UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
      <Label Content="{DynamicResource Display.CompanyPresentation.Content.TermsAndConditions}" Target="{Binding ElementName=Terms}"/>
      <TextBox x:Name="Terms" Text="{Binding Defaults.Terms,UpdateSourceTrigger=PropertyChanged}" MaxLength="8000"
        TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
      <WrapPanel Margin="0,12,0,4">
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.SaveDefaults}" Command="{Binding SaveDefaultsCommand}" Visibility="{Binding CanWriteDefaults,Converter={StaticResource Visible}}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.ResetChanges}" Command="{Binding ResetDefaultsCommand}" Visibility="{Binding CanWriteDefaults,Converter={StaticResource Visible}}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.PreviewSaVedDefaults}" Command="{Binding PreviewDefaultsCommand}" IsEnabled="{Binding CanPreviewDefaults}"/>
      </WrapPanel>
      <TextBlock Text="{Binding PreviewCaption}" TextWrapping="Wrap"/>
      <WrapPanel><Image Source="{Binding PrimaryPreview}" MaxWidth="140" MaxHeight="75" Margin="0,5,10,0"/>
       <Image Source="{Binding SecondaryPreview}" MaxWidth="140" MaxHeight="75" Margin="0,5,0,0"/></WrapPanel>
     </StackPanel>
    </ScrollViewer>
  </DataTemplate>
  <DataTemplate x:Key="Section4">
   <Grid Margin="10">
    <DockPanel>
     <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
      <DataTrigger Binding="{Binding TaxOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers></Style></DockPanel.Style>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <TextBlock Text="{DynamicResource Display.CompanyPresentation.Text.OnlyTheActiveRegistrationMarkedAsDefaultIsIncludedInInvoiceDefaults}" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <WrapPanel>
       <TextBox Width="200" Margin="0,0,8,4" MaxLength="100" Padding="5"
        Text="{Binding TaxSearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search by GSTIN or state code"
        ToolTip="Search starts at three characters"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.AddRegistration}" Command="{Binding AddTaxCommand}" IsEnabled="{Binding CanWriteDefaults}"/>
       <Button Content="{DynamicResource Display.CompanyPresentation.Content.ViewRegistration}" Command="{Binding OpenTaxCommand}"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid ItemsSource="{Binding TaxRows}" SelectedItem="{Binding SelectedTax}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
      local:MasterGridInteraction.ViewRowCommand="{Binding OpenTaxCommand}" AutomationProperties.Name="Company GST registrations" local:SettingsDisplay.GridId="Gst">
      <DataGrid.Columns>
       <DataGridTextColumn Header="GSTIN" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.GSTIN" Binding="{Binding Draft.Gstin}" Width="*"/>
       <DataGridTextColumn Header="State / UT" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.StateUT" Binding="{Binding State}" Width="*"/>
       <DataGridCheckBoxColumn Header="Active" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.Active" Binding="{Binding Draft.Active}"/>
       <DataGridCheckBoxColumn Header="Default for invoices" local:SettingsDisplay.LabelKey="CompanyPresentation.Grid.DefaultForInvoices" Binding="{Binding Draft.Default}"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
    <Border Background="{DynamicResource Palette.Canvas}" Padding="12" Visibility="{Binding TaxOpen,Converter={StaticResource Visible}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="{DynamicResource Display.CompanyPresentation.Text.GSTRegistration}" FontSize="20" FontWeight="SemiBold"/>
       <StackPanel IsEnabled="{Binding CanEnterTaxIdentity}">
        <Label Content="{DynamicResource Display.CompanyPresentation.Content.GSTIN}" Target="{Binding ElementName=TaxNumber}"/>
        <TextBox x:Name="TaxNumber" MaxLength="100" Text="{Binding TaxGstin,UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="{DynamicResource Display.CompanyPresentation.Content.StateUT}" Target="{Binding ElementName=TaxRegion}"/>
        <local:SearchableComboBox x:Name="TaxRegion" SearchItemsSource="{Binding TaxStates}" DisplayMemberPath="Label" SelectedValuePath="Key"
         SelectedValue="{Binding TaxState,Mode=TwoWay}" TextSearch.TextPath="Label"/>
       </StackPanel>
       <StackPanel IsEnabled="{Binding CanWriteRecord}">
        <CheckBox Content="{DynamicResource Display.Common.Active}" IsChecked="{Binding Active}"/>
        <CheckBox Content="{DynamicResource Display.CompanyPresentation.Content.DefaultForInvoices}" IsChecked="{Binding TaxDefault}"/>
       </StackPanel>
       <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditorActions}"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="10,5">
   <local:NoticeBanner Text="{Binding Message}"  />
   <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  </StackPanel>
  <ContentControl Content="{Binding}" IsEnabled="{Binding Authorized}">
   <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers>
    <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=local:CompanyPresentationView}}" Value="1">
     <Setter Property="ContentTemplate" Value="{StaticResource Section1}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=local:CompanyPresentationView}}" Value="2">
     <Setter Property="ContentTemplate" Value="{StaticResource Section2}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=local:CompanyPresentationView}}" Value="3">
     <Setter Property="ContentTemplate" Value="{StaticResource Section3}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=local:CompanyPresentationView}}" Value="4">
     <Setter Property="ContentTemplate" Value="{StaticResource Section4}"/>
    </DataTrigger>
   </Style.Triggers></Style></ContentControl.Style>
  </ContentControl>
 </DockPanel>
</UserControl>
