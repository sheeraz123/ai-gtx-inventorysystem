<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf">
 <Style TargetType="{x:Type local:SearchableComboBox}">
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="IsTextSearchEnabled" Value="False"/>
  <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
  <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Palette.GridLine}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
  <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  <Setter Property="ItemsPanel">
   <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
  </Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type local:SearchableComboBox}">
     <Grid>
      <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" HorizontalContentAlignment="Stretch"
       IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
       Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="Open searchable options">
       <DockPanel Margin="6,3">
        <TextBlock Text="▼" DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"/>
        <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False"
         Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
         ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ClipToBounds="True"/>
       </DockPanel>
      </ToggleButton>
      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
       IsOpen="{TemplateBinding IsDropDownOpen}" MinWidth="{TemplateBinding ActualWidth}">
       <Border Background="{DynamicResource Palette.Surface}" BorderBrush="{DynamicResource Palette.GridLine}"
        BorderThickness="1" MinWidth="200" MaxWidth="650">
        <DockPanel KeyboardNavigation.TabNavigation="Contained">
         <StackPanel DockPanel.Dock="Top" Margin="6">
          <TextBox x:Name="PART_Search" MaxLength="100" MinHeight="28" Padding="5,3"
           AutomationProperties.Name="Search options" ToolTip="Search starts after three trimmed characters"/>
          <TextBlock Text="{TemplateBinding SearchMessage}" Foreground="{DynamicResource Palette.Text}"
           AutomationProperties.LiveSetting="Polite" Margin="0,3,0,0" TextWrapping="Wrap"/>
         </StackPanel>
         <ScrollViewer x:Name="PART_Results" MaxHeight="300" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </DockPanel>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="Toggle" Property="Opacity" Value="0.65"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
