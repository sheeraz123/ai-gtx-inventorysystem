<Window x:Class="GTS.Billing.Presentation.Wpf.SaleTypeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Select Sale Type" Width="550" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource Palette.Surface}" Foreground="{DynamicResource Palette.Text}">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="ChoiceRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Frame" BorderThickness="1" CornerRadius="5" Padding="14,9"
              BorderBrush="{DynamicResource Palette.GridLine}" Background="{DynamicResource Palette.Surface}">
       <DockPanel>
        <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xECCA;" FontFamily="Segoe MDL2 Assets"
                   FontSize="19" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <ContentPresenter VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Palette.Alternate}"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Palette.InvoiceHeading}"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Palette.InvoiceAccent}"/>
        <Setter TargetName="Check" Property="Text" Value="&#xE73A;"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Palette.GridLine}" BorderThickness="1">
  <StackPanel>
   <Border Height="44" Background="{DynamicResource Palette.InvoiceAccent}">
    <DockPanel Margin="16,0,5,0" VerticalAlignment="Center">
     <Button DockPanel.Dock="Right" Width="32" Height="30" Click="CloseClicked" ToolTip="Close"
             shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close sale type dialog">
      <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
     </Button>
     <Border DockPanel.Dock="Left" CornerRadius="4" Background="White" Padding="5,1" VerticalAlignment="Center">
      <TextBlock Text="GTS" Foreground="#174A82" FontWeight="Bold"/>
     </Border>
     <TextBlock Text="Select Sale Type" Foreground="White" FontWeight="SemiBold" FontSize="20"
                VerticalAlignment="Center" Margin="11,0,0,0"/>
    </DockPanel>
   </Border>
   <StackPanel Margin="20,14,20,18">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
     <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,11,0"
                VerticalAlignment="Center"/>
     <TextBlock Text="Select a sale type to continue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <ListBox x:Name="Choices" SelectionMode="Single" ItemContainerStyle="{StaticResource ChoiceRow}"
             Background="Transparent" BorderThickness="0" AutomationProperties.Name="Sale type"
             MouseDoubleClick="ChoiceDoubleClicked" PreviewKeyDown="ChoiceKeyDown">
     <ListBoxItem>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,12,0"/>
       <TextBlock Text="Local Sale / Intra-State" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </ListBoxItem>
     <ListBoxItem>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE806;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="0,0,12,0"/>
       <TextBlock Text="Inter-State Sale" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </ListBoxItem>
    </ListBox>
    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
     <Button Content="_Cancel" IsCancel="True" MinWidth="98" Padding="12,6" Margin="0,0,8,0"/>
     <Button x:Name="Proceed" IsDefault="True" Click="ContinueClicked" MinWidth="130" Padding="12,6"
       IsEnabled="{Binding SelectedItem.IsSelected,ElementName=Choices,FallbackValue=False,TargetNullValue=False}"
       Background="{DynamicResource Palette.InvoiceAccent}" Foreground="White"/>
    </StackPanel>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
