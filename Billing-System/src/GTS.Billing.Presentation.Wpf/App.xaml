<Application x:Class="GTS.Billing.Presentation.Wpf.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="SearchableComboBox.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="BillingButton" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Palette.GridLine}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="BorderBrush" Value="{DynamicResource Palette.InvoiceAccent}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryBillingButton" TargetType="Button" BasedOn="{StaticResource BillingButton}">
   <Setter Property="Background" Value="{DynamicResource Palette.InvoiceAccent}"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource BillingButton}"/>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Palette.GridLine}"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="{DynamicResource Palette.Canvas}"/>
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Palette.InvoiceHeading}"/>
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="Padding" Value="6,3"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/>
   <Setter Property="Background" Value="{DynamicResource Palette.Surface}"/>
  </Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Palette.Text}"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
