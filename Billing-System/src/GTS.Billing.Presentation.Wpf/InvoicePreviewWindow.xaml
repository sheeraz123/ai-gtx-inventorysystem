<Window x:Class="GTS.Billing.Presentation.Wpf.InvoicePreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf"
 Title="Invoice print preview" Width="1000" Height="760" MinWidth="550" MinHeight="430"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Palette.Canvas}" Foreground="{DynamicResource Palette.Text}">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel Margin="10">
    <WrapPanel.Resources>
     <Style TargetType="Button" BasedOn="{StaticResource BillingButton}">
      <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,6,5"/>
     </Style>
    </WrapPanel.Resources>
    <Button x:Name="PreviousButton" Content="Previous" Click="Previous"/>
    <Button x:Name="NextButton" Content="Next" Click="Next"/>
    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="5,0,12,5" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="−" AutomationProperties.Name="Zoom out" Click="ZoomOut"/>
    <Button Content="+" AutomationProperties.Name="Zoom in" Click="ZoomIn"/>
    <Button Content="Fit width" Click="FitWidth"/>
    <Button Content="Fit page" Click="FitPage"/>
    <Button x:Name="PrintButton" Content="Select printer and print" Click="Print"/>
    <Button x:Name="PdfButton" Content="Export PDF" Click="ExportPdf"/>
    <Button Content="Close" IsCancel="True"/>
   </WrapPanel>
   <WrapPanel Margin="10,0,10,8">
    <Label Content="_Template" Target="{Binding ElementName=TemplateChoice}"/>
    <ComboBox x:Name="TemplateChoice" DisplayMemberPath="Name" MinWidth="260" SelectionChanged="ChangePresentation"/>
    <Label Content="Cop_y type" Target="{Binding ElementName=CopyChoice}" Margin="10,0,0,0"/>
    <ComboBox x:Name="CopyChoice" DisplayMemberPath="Name" MinWidth="185" SelectionChanged="ChangePresentation"/>
   </WrapPanel>
   <local:NoticeBanner x:Name="Notice" Margin="10,0,10,8"/>
  </StackPanel>
  <ScrollViewer x:Name="Viewport" Padding="10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
    SizeChanged="ViewportChanged">
   <Border x:Name="PageFrame" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
    <DocumentPageView x:Name="Page"/>
   </Border>
  </ScrollViewer>
 </DockPanel>
</Window>
