<UserControl x:Class="GTS.Billing.Presentation.Wpf.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,0,7,4"/><Setter Property="Padding" Value="10,5"/></Style>
 </UserControl.Resources>
 <DockPanel Margin="16" TextElement.Foreground="{DynamicResource Palette.Text}">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Text="{DynamicResource Display.Settings.Title}" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding CompanyLabel}" Margin="0,4,0,0" FontWeight="SemiBold"/>
   <local:NoticeBanner Text="{Binding Message}" Margin="0,4" />
   <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  </StackPanel>
  <ListBox DockPanel.Dock="Left" Width="182" Margin="0,0,12,0" ItemsSource="{Binding Sections}"
   SelectedItem="{Binding Section}" DisplayMemberPath="Caption" AutomationProperties.Name="Settings sections">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/></Style></ListBox.ItemContainerStyle>
  </ListBox>
  <Grid>
   <DockPanel>
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
     <DataTrigger Binding="{Binding DetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding ShowSecurity}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></DockPanel.Style>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,9"
       Visibility="{Binding IsFormsConfiguration,Converter={StaticResource Visible}}">
      <Label Content="_Configure" Target="{Binding ElementName=ConfigurationModuleSelector}"/>
      <local:SearchableComboBox x:Name="ConfigurationModuleSelector" Width="260"
        SearchItemsSource="{Binding ConfigurationModules}" SelectedItem="{Binding SelectedConfigurationModule,Mode=TwoWay}"
        DisplayMemberPath="Caption" AutomationProperties.Name="Configuration module"/>
     </StackPanel>
     <WrapPanel Margin="0,0,0,7">
      <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" DisplayMemberPath="Label" Width="142"
       Margin="0,0,8,0" AutomationProperties.Name="Settings scope"/>
      <TextBox Width="180" MaxLength="100" Padding="5" Margin="0,0,8,0" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"
        AutomationProperties.Name="Search settings" ToolTip="Search starts after three characters"/>
      <local:SearchableComboBox Width="140" SearchItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" AutomationProperties.Name="Text label module"
       Visibility="{Binding IsTextSection,Converter={StaticResource Visible}}"/>
     </WrapPanel>
     <WrapPanel>
      <Button Content="View configuration changes" Command="{Binding ViewConfigurationHistoryCommand}"
        Visibility="{Binding IsConfigurationHistory,Converter={StaticResource Visible}}"/>
      <Button Content="Copy configuration from a company" Command="{Binding CopyConfigurationCommand}"
        Visibility="{Binding IsConfigurationHistory,Converter={StaticResource Visible}}"/>
      <Button Content="{DynamicResource Display.Common.View}" Command="{Binding ViewCommand}"/>
      <Button Content="Configure invoice fields" Command="{Binding OpenSalesLayoutCommand}"
        Visibility="{Binding IsSalesLayoutSection,Converter={StaticResource Visible}}" IsEnabled="{Binding CanList}"/>
      <Button Content="{Binding ResetSectionCaption}" Command="{Binding RestoreSectionCommand}"/>
      <Button Content="Preview invoice settings" Command="{Binding PreviewCommand}"
        Visibility="{Binding CanPreviewInvoice,Converter={StaticResource Visible}}" IsEnabled="{Binding CanList}"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Visibility="{Binding HasCompanyHelp,Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding CompanyHelp}" TextWrapping="Wrap" Margin="0,5"/>
      <Button Content="Open Company Master" Command="{Binding GoToCompanyCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
     <Expander Header="Existing company presentation records" Expanded="CompanyPresentationExpanded" MaxHeight="300"
      Visibility="{Binding CompanyDetailsAvailable,Converter={StaticResource Visible}}">
      <local:CompanyPresentationView Tag="{Binding DataContext.PresentationPage,RelativeSource={RelativeSource AncestorType=local:SettingsView}}"
        DataContext="{Binding DataContext.CompanyPresentation,RelativeSource={RelativeSource AncestorType=local:SettingsView}}"/>
     </Expander>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
     CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Settings values"
     local:MasterGridInteraction.ViewRowCommand="{Binding ViewCommand}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="*"/>
      <DataGridTextColumn Header="Key" Binding="{Binding Key}"/>
      <DataGridTextColumn Header="Module" Binding="{Binding Module}"/>
      <DataGridTextColumn Header="Default" Binding="{Binding DefaultText}" Width="*"/>
      <DataGridTextColumn Header="Current value" Binding="{Binding EffectiveText}" Width="*"/>
      <DataGridTextColumn Header="Scope" Binding="{Binding Scope}"/>
      <DataGridTextColumn Header="Modified by" Binding="{Binding UpdatedBy}"/>
      <DataGridTextColumn Header="Updated (UTC)" Binding="{Binding UpdatedUtc,StringFormat=g}"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <Border Background="{DynamicResource Palette.Surface}" Padding="14" Visibility="{Binding ShowSecurity,Converter={StaticResource Visible}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="Security &amp; Diagnostics" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Password policy: Argon2id, unique salts and versioned hashes. Temporary passwords must be replaced before business access." TextWrapping="Wrap" Margin="0,10"/>
      <TextBlock Text="Login throttling and administrative lock are separate. The installation throttle applies after five failures in 30 seconds." TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="Session: authenticated. Company permissions are revalidated for protected operations. Super Admin recovery codes are single-use." TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="Installation and database identity were verified at startup. The machine-wide lock and controlled shutdown are mandatory." TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="Security and settings changes use the installation audit. The configured development database is plaintext and for synthetic data only." TextWrapping="Wrap" Margin="0,0,0,10"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Background="{DynamicResource Palette.Surface}" Padding="16" Visibility="{Binding DetailOpen,Converter={StaticResource Visible}}">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="{DynamicResource Display.Common.Edit}" Command="{Binding EditCommand}" Visibility="{Binding CanEdit,Converter={StaticResource Visible}}"/>
      <Button Content="{Binding SaveCaption}" Command="{Binding SaveCommand}" Visibility="{Binding Editing,Converter={StaticResource Visible}}"/>
      <Button Content="Restore default" Command="{Binding RestoreCommand}" Visibility="{Binding CanRestore,Converter={StaticResource Visible}}"/>
      <Button Content="Preview" Command="{Binding PreviewCommand}"/>
      <Button Content="Choose company image" Command="{Binding ChooseLoginImageCommand}" IsEnabled="{Binding CanSave}"
              Visibility="{Binding OpenedLoginImage,Converter={StaticResource Visible}}"/>
      <Button Content="Check printer availability" Command="{Binding CheckPrinterCommand}" Visibility="{Binding OpenedPrinter,Converter={StaticResource Visible}}"/>
      <Button Command="{Binding CancelCommand}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="{DynamicResource Display.Common.Close}"/>
        <Style.Triggers><DataTrigger Binding="{Binding Editing}" Value="True">
         <Setter Property="Content" Value="{DynamicResource Display.Common.Cancel}"/>
        </DataTrigger></Style.Triggers>
       </Style></Button.Style>
      </Button>
     </WrapPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding DetailKey}" Margin="0,6" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding DetailScope,StringFormat='Scope: {0}'}" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding DetailDefault,StringFormat='Built-in default: {0}'}" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding LastUpdated}" Margin="0,0,0,8" TextWrapping="Wrap"/>
       <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" MaxLength="800" Padding="5" TextWrapping="Wrap"
        AutomationProperties.Name="Setting value" Visibility="{Binding CanUseText,Converter={StaticResource Visible}}">
        <TextBox.Style><Style TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/>
         <Style.Triggers><DataTrigger Binding="{Binding CanSave}" Value="True"><Setter Property="IsReadOnly" Value="False"/></DataTrigger></Style.Triggers>
        </Style></TextBox.Style>
       </TextBox>
       <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                 SelectedValue="{Binding Value,Mode=TwoWay}" IsEnabled="{Binding CanSave}"
        Visibility="{Binding CanUseChoice,Converter={StaticResource Visible}}" AutomationProperties.Name="Setting value options"/>
       <TextBlock Text="{Binding TemplateDetails}" TextWrapping="Wrap" Margin="0,9,0,0"
        Visibility="{Binding OpenedInvoiceTemplate,Converter={StaticResource Visible}}"/>
       <local:NoticeBanner Text="{Binding Validation}" Kind="Error" Margin="0,6"/>
       <TextBlock Text="{Binding RestartNote}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,7" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
