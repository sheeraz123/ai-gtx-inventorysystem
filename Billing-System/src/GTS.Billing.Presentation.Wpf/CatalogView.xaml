<UserControl x:Class="GTS.Billing.Presentation.Wpf.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate DataType="{x:Type local:CustomerField}">
   <StackPanel Margin="5,5">
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" MinHeight="30" MaxHeight="110"
      Padding="5" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsText,Converter={StaticResource Visible}}"/>
    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key"
      SelectedValue="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="30"
      IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="{Binding Label}"
      Visibility="{Binding IsChoice,Converter={StaticResource Visible}}"/>
    <DatePicker SelectedDate="{Binding DateValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsDate,Converter={StaticResource Visible}}"/>
    <CheckBox IsChecked="{Binding Checked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsCheck,Converter={StaticResource Visible}}"/>
    <TextBlock Text="{Binding Error}" Foreground="#A31621" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Message}" Margin="0,6" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  </StackPanel>
  <Grid>
   <DockPanel>
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
     <DataTrigger Binding="{Binding EditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></DockPanel.Style>
    <StackPanel DockPanel.Dock="Top">
     <WrapPanel Margin="0,6">
      <TextBox Width="190" MaxLength="100" Padding="5" ToolTip="Search starts at three characters"
       AutomationProperties.Name="Search records" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/>
      <ComboBox Margin="5,0" Width="130" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}"
       DisplayMemberPath="Label" AutomationProperties.Name="Status filter"/>
      <ComboBox Width="175" ItemsSource="{Binding FilterChoices}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Label"
       Visibility="{Binding Products,Converter={StaticResource Visible}}" AutomationProperties.Name="Category filter"/>
      <ComboBox Margin="5,0" Width="100" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}"
       Visibility="{Binding Products,Converter={StaticResource Visible}}" AutomationProperties.Name="Product type filter (blank means all)"/>
      <Button Content="_Refresh" Command="{Binding RefreshCommand}" Padding="8,4"/>
     </WrapPanel>
     <WrapPanel Margin="0,3,0,8">
      <Button Content="_Add" Command="{Binding AddCommand}" IsEnabled="{Binding CanBrowse}" Padding="10,5"/>
      <Button Content="_View" Command="{Binding ViewCommand}" Margin="5,0" Padding="10,5"/>
      <Button Content="_Edit" Command="{Binding EditCommand}" Padding="10,5"/>
      <Button Content="Activate / _Deactivate" Command="{Binding ChangeStatusCommand}" Margin="5,0" Padding="10,5"/>
     </WrapPanel>
    </StackPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8">
     <Button Content="Previous" Command="{Binding PreviousCommand}"/>
     <TextBlock Margin="8,0" Text="{Binding PageLabel}"/>
     <Button Content="Next" Command="{Binding NextCommand}"/>
    </WrapPanel>
    <Grid>
     <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" SelectionMode="Single" local:MasterGridInteraction.ViewRowCommand="{Binding ViewCommand}" AutomationProperties.Name="Product categories">
      <DataGrid.Style><Style TargetType="DataGrid"><Style.Triggers>
       <DataTrigger Binding="{Binding Products}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></DataGrid.Style>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
        <DataGridTextColumn Header="Parent category" Binding="{Binding Category}"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
        <DataGridTextColumn Header="Sort order" Binding="{Binding SortOrder}"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
      </DataGrid.Columns>
     </DataGrid>
     <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" SelectionMode="Single" local:MasterGridInteraction.ViewRowCommand="{Binding ViewCommand}"
      Visibility="{Binding Products,Converter={StaticResource Visible}}" AutomationProperties.Name="Products">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Kind}"/>
        <DataGridTextColumn Header="Base unit" Binding="{Binding BaseUnit}"/>
        <DataGridTextColumn Header="HSN / SAC" Binding="{Binding Hsn}"/>
        <DataGridTextColumn Header="Sales rate" Binding="{Binding SalesRate}"/>
        <DataGridTextColumn Header="MRP" Binding="{Binding Mrp}"/>
        <DataGridCheckBoxColumn Header="Stock tracked" Binding="{Binding StockTracked}"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </DockPanel>
   <Border Background="#F3F5F8" Visibility="{Binding EditorOpen,Converter={StaticResource Visible}}" Padding="10">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Bottom" Margin="0,8">
      <Button Content="_Edit" Command="{Binding EditCommand}" Visibility="{Binding ViewOnly,Converter={StaticResource Visible}}" Padding="10,5"/>
      <Button Content="_Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Padding="10,5">
       <Button.Style><Style TargetType="Button"><Style.Triggers>
        <DataTrigger Binding="{Binding ViewOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
      <Button Click="CloseEditor" Margin="6,0" Padding="10,5">
       <Button.Style><Style TargetType="Button"><Setter Property="Content" Value="_Cancel"/><Style.Triggers>
        <DataTrigger Binding="{Binding ViewOnly}" Value="True"><Setter Property="Content" Value="_Close"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
     </WrapPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <StackPanel IsEnabled="{Binding CanSave}">
        <TextBlock FontWeight="SemiBold">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Parent category"/><Style.Triggers>
          <DataTrigger Binding="{Binding Products}" Value="True"><Setter Property="Text" Value="Category *"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Link}" DisplayMemberPath="Label" TextSearch.TextPath="Label"
         AutomationProperties.Name="Category or parent category"/>
        <TextBlock Text="{Binding LinkError}" Foreground="#A31621" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Sections}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,4" Background="White" Padding="8">
           <ItemsControl ItemsSource="{Binding Fields}"/>
          </Expander>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
       <StackPanel Visibility="{Binding ShowImage,Converter={StaticResource Visible}}">
        <Image Source="{Binding Preview}" MaxWidth="220" MaxHeight="140" HorizontalAlignment="Left" AutomationProperties.Name="Product image"/>
        <WrapPanel IsEnabled="{Binding CanSave}" Margin="0,5">
         <Button Content="Choose or _replace image" Click="ChooseImage" Padding="8,4"/>
         <Button Content="Re_move image" Click="RemoveImage" Padding="8,4" Margin="5,0"/>
        </WrapPanel>
       </StackPanel>
       <TextBlock Text="{Binding Audit}" Margin="0,6" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
