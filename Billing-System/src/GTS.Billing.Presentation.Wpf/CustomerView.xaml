<UserControl x:Class="GTS.Billing.Presentation.Wpf.CustomerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GTS.Billing.Presentation.Wpf">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate DataType="{x:Type local:CustomerField}">
   <StackPanel Margin="5,5">
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" MinHeight="30" MaxHeight="110"
      Padding="5" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsText,Converter={StaticResource Visible}}"/>
    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key"
      SelectedValue="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="30"
      IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="{Binding Label}"
      Visibility="{Binding IsFixedChoice,Converter={StaticResource Visible}}">
     <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding ReadOnly}" Value="True">
      <Setter Property="IsEnabled" Value="False"/>
     </DataTrigger></Style.Triggers></Style></ComboBox.Style>
    </ComboBox>
    <local:SearchableComboBox SearchItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key"
      SelectedValue="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInput}"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsSearchableChoice,Converter={StaticResource Visible}}"/>
    <DatePicker SelectedDate="{Binding DateValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsDate,Converter={StaticResource Visible}}"/>
    <CheckBox IsChecked="{Binding Checked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}"
      AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsCheck,Converter={StaticResource Visible}}"/>
    <TextBlock Text="{Binding Error}" Foreground="#A31621" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CustomerEntryEditor}">
   <Expander Header="{Binding Header}" IsExpanded="True" Margin="0,6" Background="{DynamicResource Palette.Surface}" Padding="8">
    <StackPanel>
     <ItemsControl ItemsSource="{Binding Fields}"/>
     <Button Content="{Binding RetireLabel}" Command="{Binding RetireCommand}" HorizontalAlignment="Left" Margin="5" Padding="10,5"/>
     <TextBlock Text="{DynamicResource Display.Customer.Text.ExistingEntriesAreRetainedWhenDeactivated}" Foreground="{DynamicResource Palette.Muted}" Margin="5"/>
    </StackPanel>
   </Expander>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{DynamicResource Display.Customer.Title}" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding CompanyCaption}" TextWrapping="Wrap" Margin="0,5"/>
   <Button Content="{DynamicResource Display.Customer.Content.OpenCompanyMaster}" Click="OpenCompanyMaster" HorizontalAlignment="Left" Padding="8,3" Margin="0,3"/>
  </StackPanel>
  <StackPanel Grid.Row="1"><local:NoticeBanner Text="{Binding Message}" Margin="0,5" />
   <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
  </StackPanel>
  <local:NoticeBanner Grid.Row="2" Text="{Binding ValidationSummary}" Kind="Error" Margin="0,3"/>
  <Grid Grid.Row="3">
   <DockPanel>
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
     <DataTrigger Binding="{Binding EditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></DockPanel.Style>
    <StackPanel DockPanel.Dock="Top">
     <WrapPanel Margin="0,4">
      <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="100" Padding="5"
       ToolTip="Search starts at three characters" AutomationProperties.Name="Search customer code, name, GSTIN, mobile or city"/>
      <ComboBox ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding StatusFilter}" Width="135" Margin="5,0" AutomationProperties.Name="Filter customer status"/>
      <ComboBox ItemsSource="{Binding RegistrationFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding RegistrationFilter}" Width="160" AutomationProperties.Name="Filter GST registration"/>
      <Button Content="{DynamicResource Display.Common.Refresh}" Command="{Binding RefreshCommand}" Padding="8,5" Margin="5,0"/>
     </WrapPanel>
     <WrapPanel Margin="0,4">
      <Button Content="{DynamicResource Display.Customer.Content.AddCustomer}" Command="{Binding AddCommand}" Padding="8,5"/>
      <Button Content="{DynamicResource Display.Common.Edit}" Command="{Binding EditCommand}" Padding="8,5" Margin="5,0"/>
      <Button Content="{DynamicResource Display.Customer.Content.ViewDetails}" Command="{Binding ViewCommand}" Padding="8,5"/>
      <Button Content="{DynamicResource Display.Customer.Content.Activate}" Command="{Binding StatusCommand}" CommandParameter="Active" Padding="8,5" Margin="5,0"/>
      <Button Content="{DynamicResource Display.Customer.Content.Deactivate}" Command="{Binding StatusCommand}" CommandParameter="Inactive" Padding="8,5"/>
      <Button Content="{DynamicResource Display.Customer.Content.Block}" Command="{Binding StatusCommand}" CommandParameter="Blocked" Padding="8,5" Margin="5,0"/>
     </WrapPanel>
    </StackPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8">
     <Button Content="{DynamicResource Display.Customer.Content.Previous}" Command="{Binding PreviousPageCommand}" Padding="8,4"/>
     <TextBlock Text="{Binding PageCaption}" Margin="10,5"/>
     <Button Content="{DynamicResource Display.Customer.Content.Next}" Command="{Binding NextPageCommand}" Padding="8,4"/>
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Company-scoped customers" local:SettingsDisplay.GridId="Customers"
      local:MasterGridInteraction.ViewRowCommand="{Binding ViewCommand}">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
      <DataTrigger Binding="{Binding CreditHold}" Value="True"><Setter Property="Background" Value="#FFF0C2"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Blocked"><Setter Property="Background" Value="#FFE1E1"/></DataTrigger>
     </Style.Triggers></Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Code" local:SettingsDisplay.LabelKey="Customer.Grid.Code" Binding="{Binding Code}"/>
      <DataGridTextColumn Header="Customer name" local:SettingsDisplay.LabelKey="Customer.Grid.CustomerName" Binding="{Binding LegalName}" Width="*"/>
      <DataGridTextColumn Header="Trade name" local:SettingsDisplay.LabelKey="Customer.Grid.TradeName" Binding="{Binding TradeName}"/>
      <DataGridTextColumn Header="GSTIN" local:SettingsDisplay.LabelKey="Customer.Grid.GSTIN" Binding="{Binding Gstin}"/>
      <DataGridTextColumn Header="Mobile" local:SettingsDisplay.LabelKey="Customer.Grid.Mobile" Binding="{Binding Mobile}"/>
      <DataGridTextColumn Header="City" local:SettingsDisplay.LabelKey="Customer.Grid.City" Binding="{Binding City}"/>
      <DataGridTextColumn Header="State" local:SettingsDisplay.LabelKey="Customer.Grid.State" Binding="{Binding State}"/>
      <DataGridTextColumn Header="Credit days" local:SettingsDisplay.LabelKey="Customer.Grid.CreditDays" Binding="{Binding CreditDays}"/>
      <DataGridTextColumn Header="Credit limit" local:SettingsDisplay.LabelKey="Customer.Grid.CreditLimit" Binding="{Binding CreditLimit}"/>
      <DataGridCheckBoxColumn Header="Credit hold" local:SettingsDisplay.LabelKey="Customer.Grid.CreditHold" Binding="{Binding CreditHold}"/>
      <DataGridTextColumn Header="Status" local:SettingsDisplay.LabelKey="Customer.Grid.Status" Binding="{Binding Status}"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <Border Background="{DynamicResource Palette.Canvas}" Visibility="{Binding EditorOpen,Converter={StaticResource Visible}}">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Bottom" Margin="4,8">
      <Button Content="{DynamicResource Display.Common.Edit}" Command="{Binding EditViewedCommand}" Visibility="{Binding ViewOnly,Converter={StaticResource Visible}}" Padding="12,6"/>
      <Button Content="{DynamicResource Display.Customer.Content.SaveCustomer}" Command="{Binding SaveCommand}" Padding="12,6">
       <Button.Style><Style TargetType="Button"><Style.Triggers>
        <DataTrigger Binding="{Binding ViewOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
      <Button Click="CancelEditor" IsEnabled="{Binding CanCancel}" Padding="12,6" Margin="8,0">
       <Button.Style><Style TargetType="Button"><Setter Property="Content" Value="{DynamicResource Display.Common.Cancel}"/><Style.Triggers>
        <DataTrigger Binding="{Binding ViewOnly}" Value="True"><Setter Property="Content" Value="{DynamicResource Display.Common.Close}"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
     </WrapPanel>
     <TabControl>
      <TabItem Header="{DynamicResource Display.Customer.Header.General}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding GeneralFields}" IsEnabled="{Binding CanEdit}" Margin="8"/></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.GSTTax}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <TextBlock Text="{DynamicResource Display.Customer.Text.GSTINAndPANAreOptionalSelectTheRegisteredStateUTFromTheListIfApplicable}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding TaxFields}" IsEnabled="{Binding CanEdit}"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.Billing}">
       <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="{DynamicResource Display.Customer.Content.AddBillingAddress}" Command="{Binding AddBillingCommand}" HorizontalAlignment="Left" Padding="10,5"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding BillingAddresses}" IsEnabled="{Binding CanEdit}"/></ScrollViewer>
       </DockPanel>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.Shipping}">
       <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="{DynamicResource Display.Customer.Content.AddShippingAddress}" Command="{Binding AddShippingCommand}" HorizontalAlignment="Left" Padding="10,5"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ShippingAddresses}" IsEnabled="{Binding CanEdit}"/></ScrollViewer>
       </DockPanel>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.Contacts}">
       <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="{DynamicResource Display.Customer.Content.AddContactPerson}" Command="{Binding AddContactCommand}" HorizontalAlignment="Left" Padding="10,5"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Contacts}" IsEnabled="{Binding CanEdit}"/></ScrollViewer>
       </DockPanel>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.TermsCredit}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <TextBlock Text="{Binding CreditWarning}" FontWeight="Bold" Foreground="#8A4800" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding CreditFields}" IsEnabled="{Binding CanEditCredit}"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.OpeningDraft}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <TextBlock Text="{Binding OpeningExplanation}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding OpeningFields}" IsEnabled="{Binding CanEditCredit}"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.BankDetails}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <TextBlock Text="Customer payment/refund references only. Synthetic data only in this unencrypted database. Never enter banking passwords, OTPs, UPI PINs, CVV or card credentials. These details are excluded from invoice snapshots." TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding BankFields}" IsEnabled="{Binding CanEditBank}"
         Visibility="{Binding CanSeeBank,Converter={StaticResource Visible}}"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Display.Customer.Header.NotesAudit}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
        <ItemsControl ItemsSource="{Binding NotesFields}" IsEnabled="{Binding CanEdit}"/>
        <TextBlock Text="{Binding AuditCaption}" TextWrapping="Wrap" Margin="5,12"/>
        <TextBlock Text="{Binding InvoiceReadiness}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="5"/>
        <TextBlock Text="{Binding FinancialAvailability}" TextWrapping="Wrap" Foreground="{DynamicResource Palette.Muted}" Margin="5,15"/>
       </StackPanel></ScrollViewer>
      </TabItem>
     </TabControl>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
