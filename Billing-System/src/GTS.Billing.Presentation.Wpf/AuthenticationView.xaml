<UserControl x:Class="GTS.Billing.Presentation.Wpf.AuthenticationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel MaxWidth="620" Margin="32,22">
   <TextBlock Text="GTS Billing System" FontSize="28" FontWeight="SemiBold" />
   <TextBlock Text="UNENCRYPTED DEVELOPMENT DATABASE — synthetic credentials only." Margin="0,8,0,16" TextWrapping="Wrap" />
   <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
   <TextBlock x:Name="Instructions" Margin="0,8" TextWrapping="Wrap" />
   <StackPanel x:Name="Form">
    <StackPanel x:Name="UsernameRow">
     <Label Content="_Username" Target="{Binding ElementName=Username}" />
     <TextBox x:Name="Username" AutomationProperties.Name="GTS username" MaxLength="128" />
    </StackPanel>
    <StackPanel x:Name="CodeRow">
     <Label Content="Recovery _code" Target="{Binding ElementName=Code}" />
     <PasswordBox x:Name="Code" AutomationProperties.Name="Recovery code" MaxLength="64" />
    </StackPanel>
    <Label x:Name="PasswordLabel" Content="_Password" Target="{Binding ElementName=PasswordField}" />
    <PasswordBox x:Name="PasswordField" AutomationProperties.Name="Password" MaxLength="512" />
    <StackPanel x:Name="ConfirmationRow">
     <Label Content="C_onfirm password" Target="{Binding ElementName=Confirmation}" />
     <PasswordBox x:Name="Confirmation" AutomationProperties.Name="Confirm password" MaxLength="512" />
    </StackPanel>
    <WrapPanel Margin="0,14,0,0">
     <Button x:Name="Submit" Content="_Continue" IsDefault="True" Click="SubmitClicked" Padding="12,5" />
     <Button x:Name="Recovery" Content="_Recover Super Admin password" Click="RecoveryClicked" Margin="8,0,0,0" Padding="12,5" />
     <Button x:Name="Cancel" Content="_Back" Click="CancelClicked" Margin="8,0,0,0" Padding="12,5" />
    </WrapPanel>
   </StackPanel>
   <StackPanel x:Name="CodePanel">
    <ItemsControl x:Name="CodeList" FontFamily="Consolas" FontSize="15" AutomationProperties.Name="Ten sensitive recovery codes" />
    <WrapPanel Margin="0,12,0,0">
     <Button x:Name="Print" Content="_Print" Padding="12,5" />
     <Button x:Name="Save" Content="_Save" Padding="12,5" Margin="8,0,0,0" />
     <Button x:Name="Continue" Content="_Continue" Click="ContinueClicked" Padding="12,5" Margin="8,0,0,0" />
    </WrapPanel>
   </StackPanel>
   <TextBlock Text="{Binding Message}" Foreground="#892500" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock x:Name="DocumentStatus" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
